{
  "name": "tizeosn",
  "type": "module",
  "appName": "TizeOSN",
  "version": "1.0.4",
  "description": "TizeOSN is an ad-free, sponsor-free and enhanced client for OSN+ on Samsung Smart TVs (Tizen OS), launched via TizenBrew.",
  "packageType": "mods",
  "websiteURL": "https://tizen.osnplus.com",
  "main": "dist/userScript.js",
  "author": "TizeOSN Contributors",
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "MediaFastForward",
    "MediaRewind",
    "MediaTrackNext",
    "MediaTrackPrevious"
  ],
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w"
  },
  "keywords": [
    "tizenbrew",
    "tizen",
    "osn",
    "osnplus",
    "adblock",
    "samsung-tv",
    "smart-tv",
    "tizentube"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iHosam/TizeOSN"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.64.7"
  }
}
